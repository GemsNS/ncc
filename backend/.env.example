NODE_ENV=production
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=1

# Required in production (server refuses to start without these)
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@wearencc.org
ADMIN_PASSWORD=replace-with-strong-password
CORS_ORIGIN=https://wearencc.org,https://www.wearencc.org

# Optional: OpenAI for prayer chat (server-side only). If unset, keyword-based replies are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# PRAYER_AI_SYSTEM_PROMPT=
